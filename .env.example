# Copy to .env and fill in. .env is gitignored — never commit real values.
# Operational parameters live in config.yaml; ONLY secrets belong here.

# --- AI veto layer --------------------------------------------------------
ANTHROPIC_API_KEY=

# --- news provider for the veto layer (optional; layer degrades gracefully)
NEWS_API_KEY=

# --- IBKR -----------------------------------------------------------------
# No password here. IB Gateway holds the session; we connect to a local socket.
# Host/port/client_id live in config.yaml under `execution`.
# Set this to the paper account id as a guard against pointing at the live one.
IBKR_EXPECTED_ACCOUNT_ID=

# --- paths (optional overrides) -------------------------------------------
WM_DB_PATH=./db/operations.db
WM_CACHE_DIR=./data/cache
